# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.
# Never commit real values.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=
# Database name inside the cluster
MONGODB_DB=lumen
# Long random string; you type it on /admin to read requests
ADMIN_TOKEN=
# Optional: any random string, used to hash visitor IPs for rate limiting
IP_SALT=
# Optional fallback if the database is down: a Formspree endpoint
VITE_FORM_ENDPOINT=
